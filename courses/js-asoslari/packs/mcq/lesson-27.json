        "element.addEvent('click', fn)",
        "element.addEventListener('click', fn)",
        "element.onEvent('click', fn)",
        "element.click(fn)"
      ],
      "correct": 1,
      "exp": "addEventListener() hodisa (event) tinglovchisini qo'shadi."
    },
