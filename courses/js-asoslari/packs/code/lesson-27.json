      "task": "link click da preventDefault va 'toxtatildi'.",
      "sample": "const link = document.querySelector(\"a\");\nif (link) {\n  link.addEventListener(\"click\", (e) => {\n    e.preventDefault();\n    console.log(\"toxtatildi\");\n  });\n}",
